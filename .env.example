# Copy to .env — never commit real values
MARKET_MODE=sim
MARKET_BROKER=sim

# Robinhood unofficial adapter (Phase 3+) — high ToS/ban risk
# Live submits require MARKET_RH_LIVE=1 AND mode=live AND broker.allow_live
MARKET_RH_USERNAME=
MARKET_RH_PASSWORD=
MARKET_RH_TOTP_SECRET=
MARKET_RH_LIVE=0
MARKET_RH_FAKE_LOGIN=0

