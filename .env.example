# Copy to .env — never commit real values
MARKET_MODE=sim
MARKET_BROKER=sim

# Official Robinhood Crypto Trading API (read-only credential first).
# Keep the private key outside this repository. Live submission is disabled by the build.
MARKET_RH_API_KEY=
MARKET_RH_PRIVATE_KEY_PATH=
MARKET_RH_LIVE=0

