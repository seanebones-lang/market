# Copy to .env — never commit real values
MARKET_MODE=sim
MARKET_BROKER=sim

# Official Robinhood Crypto Trading API secrets are never loaded from .env.
# The authorized read-only credential is stored in macOS Keychain.
# Live submission remains disabled by the build.
MARKET_RH_LIVE=0

# Optional later
# MARKET_COINBASE_API_KEY=
# MARKET_COINBASE_API_SECRET=
# MARKET_TELEGRAM_BOT_TOKEN=
# MARKET_TELEGRAM_CHAT_ID=
